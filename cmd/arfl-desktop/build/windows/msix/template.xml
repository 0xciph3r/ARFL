<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="arfl-desktop"
        Arguments=""
        InstallLocation="C:\Program Files\Radi Labs\ARFL">
    </Installer>
    <PackageInformation
        PackageName="ARFL"
        PackageDisplayName="ARFL"
        PublisherName="CN=Radi Labs"
        PublisherDisplayName="Radi Labs"
        Version="0.1.0.0"
        PackageDescription="A arfl-desktop application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.arfl.desktop"
                Description="A arfl-desktop application"
                DisplayName="ARFL"
                ExecutableName="arfl-desktop"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>ARFL</DisplayName>
            <PublisherDisplayName>Radi Labs</PublisherDisplayName>
            <Description>A arfl-desktop application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="arfl-desktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
